{
  "name": "autocross-edu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,vite -c cyan,magenta \"npm run dev:server\" \"vite\"",
    "dev:vite": "vite",
    "dev:server": "npx tsx server/dev.ts",
    "build": "vite build && npm run build:server",
    "build:server": "npx esbuild server/dev.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/server.js",
    "preview": "vite preview",
    "cap:sync": "vite build && npx cap sync",
    "cap:android": "vite build && npx cap sync && npx cap open android",
    "cap:ios": "vite build && npx cap sync && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@google/generative-ai": "^0.21.0",
    "@supabase/supabase-js": "^2.110.2",
    "@vercel/node": "^5.9.9",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^10.0.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
