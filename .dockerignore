# ── Dependencies / build cache ──────────────────────────────────────────────
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Build output (rebuilt in Docker) ────────────────────────────────────────
dist
.vite

# ── Git ──────────────────────────────────────────────────────────────────────
.git
.github
.gitignore

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo

# ── Environment secrets — NEVER bake into image ───────────────────────────────
.env
.env.local
.env.*.local

# ── Mobile / Capacitor (not needed for web build) ────────────────────────────
android
ios
*.apk
*.ipa
capacitor.config.ts

# ── Vercel local config ───────────────────────────────────────────────────────
.vercel

# ── Misc ──────────────────────────────────────────────────────────────────────
Dockerfile
.dockerignore
README.md
*.md
