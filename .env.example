# AutoCross-Edu — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Google Gemini AI ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ── Resend Email Service ──────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
VITE_RESEND_API_KEY=re_your-resend-api-key-here

# The 'from' address for emails — must be a verified domain in your Resend account
VITE_RESEND_FROM_EMAIL=noreply@anurag.edu.in
