# AutoCross-Edu — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── Google Gemini AI ─────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# For production: Use multiple keys for load balancing and avoiding rate limits

# Individual keys (used by server-side API)
GEMINI_API_KEY_1=your-gemini-api-key-1
GEMINI_API_KEY_2=your-gemini-api-key-2
GEMINI_API_KEY_3=your-gemini-api-key-3
GEMINI_API_KEY_4=your-gemini-api-key-4
GEMINI_API_KEY_5=your-gemini-api-key-5
GEMINI_API_KEY_6=your-gemini-api-key-6
GEMINI_API_KEY_7=your-gemini-api-key-7
GEMINI_API_KEY_8=your-gemini-api-key-8

# Comma-separated list (backward compatibility)
GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8

# Primary key (for local development)
GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# ── Resend Email Service ──────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
VITE_RESEND_API_KEY=re_your-resend-api-key-here

# The 'from' address for emails — must be a verified domain in your Resend account
VITE_RESEND_FROM_EMAIL=noreply@anurag.edu.in
